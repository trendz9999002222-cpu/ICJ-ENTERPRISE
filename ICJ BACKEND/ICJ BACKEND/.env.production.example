# ICJ ENTERPRISE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# Hostinger VPS / Enterprise Production Deployment Configuration

NODE_ENV=production
PORT=5000
VITE_APP_ENV=production

# 1. POSTGRESQL DATABASE CONFIGURATION
DATABASE_URL="postgresql://postgres:PROD_SECURE_PASSWORD@127.0.0.1:5432/icj_prod_db?schema=public&sslmode=require&connection_limit=50"
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=icj_prod_db
POSTGRES_USER=icj_prod_user
POSTGRES_PASSWORD=PROD_SECURE_PASSWORD
POSTGRES_SSL=true
POSTGRES_POOL_SIZE=50
POSTGRES_TIMEOUT_MS=5000

# 2. SMTP EMAIL GATEWAY
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.PROD_SENDGRID_KEY_SECRET
SMTP_FROM=notifications@icj.org.in
SMTP_TLS=true

# 3. SMS GATEWAY
SMS_PROVIDER=MSG91
SMS_API_KEY=PROD_MSG91_AUTH_KEY_SECRET
SMS_SENDER_ID=ICJGOV

# 4. WHATSAPP BUSINESS API
WA_PHONE_NUMBER_ID=109283746592011
WA_ACCESS_TOKEN=EAAG_PROD_META_WHATSAPP_TOKEN
WA_BUSINESS_ID=882736192038475

# 5. PAYMENT GATEWAY (RAZORPAY)
PAYMENT_PROVIDER=Razorpay
PAYMENT_KEY_ID=rzp_live_PROD_KEY_ID
PAYMENT_KEY_SECRET=PROD_RAZORPAY_SECRET_KEY
PAYMENT_MODE=live

# 6. GOOGLE MAPS API
GOOGLE_MAPS_API_KEY=AIzaSy_PROD_GOOGLE_MAPS_KEY

# 7. OCR ENGINE (GOOGLE VISION / TESSERACT)
OCR_PROVIDER=GoogleVision
OCR_API_KEY=AIzaSy_PROD_GOOGLE_VISION_KEY

# 8. AI PROVIDER (GOOGLE GEMINI)
AI_PROVIDER=GoogleGemini
AI_API_KEY=AIzaSy_PROD_GEMINI_API_KEY
AI_MODEL=gemini-1.5-pro

# 9. CLOUD STORAGE (AWS S3)
STORAGE_PROVIDER=AWSS3
STORAGE_BUCKET=icj-enterprise-vault-prod
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=AKIA_PROD_AWS_KEY
STORAGE_SECRET_KEY=PROD_AWS_SECRET_KEY

# 10. DOMAIN & SECURITY
DOMAIN_NAME=app.icj.org.in
FORCE_HTTPS=true
SSL_CERT_PATH=/etc/letsencrypt/live/app.icj.org.in/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/app.icj.org.in/privkey.pem
CORS_ORIGINS=https://app.icj.org.in,https://api.icj.org.in
