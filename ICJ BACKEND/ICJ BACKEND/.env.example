# ICJ ENTERPRISE PLATFORM v1.0 PRE-PRODUCTION — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate production credentials before launching.

# SUPABASE CLIENT CONFIGURATION
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# POSTGRESQL DATABASE CONFIGURATION
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/icj_enterprise_db?schema=public&connection_limit=20"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=icj_enterprise_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_SSL=true
POSTGRES_POOL_SIZE=20
POSTGRES_TIMEOUT_MS=5000

# GATEWAY & PROVIDER VAULT CONFIGURATION
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token

WA_BUSINESS_ID=your_whatsapp_business_id
WA_ACCESS_TOKEN=your_whatsapp_access_token

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

STORAGE_S3_BUCKET=icj-vault-production
STORAGE_AWS_REGION=ap-south-1
