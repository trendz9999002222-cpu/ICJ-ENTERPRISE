# ICJ ENTERPRISE PLATFORM — STAGING ENVIRONMENT CONFIGURATION TEMPLATE (.env.staging.example)
# Staging / Pre-Production Validation Configuration

NODE_ENV=staging
PORT=5000
VITE_APP_ENV=staging

# 1. POSTGRESQL DATABASE CONFIGURATION (STAGING)
DATABASE_URL="postgresql://postgres:STAGING_PASSWORD@localhost:5432/icj_staging_db?schema=public&connection_limit=10"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=icj_staging_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=STAGING_PASSWORD
POSTGRES_SSL=false
POSTGRES_POOL_SIZE=10
POSTGRES_TIMEOUT_MS=5000

# 2. SMTP EMAIL GATEWAY (STAGING)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging_user
SMTP_PASS=staging_password
SMTP_FROM=staging@icj.org.in
SMTP_TLS=false

# 3. SMS GATEWAY (STAGING / MOCK)
SMS_PROVIDER=Twilio
SMS_API_KEY=STAGING_TWILIO_SID
SMS_AUTH_TOKEN=STAGING_TWILIO_TOKEN
SMS_SENDER_ID=ICJTEST

# 4. WHATSAPP BUSINESS API (STAGING)
WA_PHONE_NUMBER_ID=100000000000000
WA_ACCESS_TOKEN=EAAG_STAGING_TOKEN
WA_BUSINESS_ID=800000000000000

# 5. PAYMENT GATEWAY (RAZORPAY TEST)
PAYMENT_PROVIDER=Razorpay
PAYMENT_KEY_ID=rzp_test_STAGING_KEY
PAYMENT_KEY_SECRET=STAGING_SECRET_KEY
PAYMENT_MODE=test

# 6. GOOGLE MAPS API (STAGING)
GOOGLE_MAPS_API_KEY=AIzaSy_STAGING_MAPS_KEY

# 7. OCR ENGINE (TESSERACT LOCAL / MOCK)
OCR_PROVIDER=TesseractLocal
OCR_API_KEY=LOCAL_OCR_ENGINE

# 8. AI PROVIDER (GEMINI STAGING)
AI_PROVIDER=GoogleGemini
AI_API_KEY=AIzaSy_STAGING_GEMINI_KEY
AI_MODEL=gemini-1.5-flash

# 9. CLOUD STORAGE (MINIO / S3 STAGING)
STORAGE_PROVIDER=MinIO
STORAGE_BUCKET=icj-staging-vault
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# 10. DOMAIN & SECURITY (STAGING)
DOMAIN_NAME=staging.icj.org.in
FORCE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=
CORS_ORIGINS=http://localhost:5173,https://staging.icj.org.in
