# ICJ Enterprise Platform - Environment Example
# Copy to .env.local for local dev or .env.staging for staging deployment.

# Build and routing
VITE_APP_BASE_PATH=/
VITE_BUILD_SOURCEMAP=false

# Supabase integration
VITE_ENABLE_SUPABASE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Auth fallback controls
# Keep mock auth disabled for staging/production.
VITE_ENABLE_MOCK_AUTH=false
# true = never fallback to mock when Supabase is enabled but fails.
VITE_AUTH_STRICT_MODE=true

# OTP channels (kept disabled by default)
ENABLE_SMS_OTP=false
ENABLE_WHATSAPP_OTP=false
ENABLE_EMAIL_OTP=false

# Vite-exposed OTP channel flags (must stay false until providers are integrated)
VITE_ENABLE_SMS_OTP=false
VITE_ENABLE_WHATSAPP_OTP=false
VITE_ENABLE_EMAIL_OTP=false

# Anti-abuse security controls
VITE_ENABLE_REGISTRATION_RATE_LIMIT=true
VITE_ENABLE_LOGIN_RATE_LIMIT=true
VITE_ENABLE_BRUTE_FORCE_PROTECTION=true
VITE_ENABLE_ACCOUNT_LOCKOUT=true
VITE_ENABLE_ADAPTIVE_RISK_SCORING=true
# Keep false by default; enable only after policy approval.
VITE_ENABLE_ADAPTIVE_RISK_BLOCK=false

# Anti-abuse thresholds
VITE_AUTH_REGISTRATION_MAX_ATTEMPTS=5
VITE_AUTH_REGISTRATION_WINDOW_MINUTES=15
VITE_AUTH_LOGIN_MAX_ATTEMPTS=8
VITE_AUTH_LOGIN_WINDOW_MINUTES=15
VITE_AUTH_BRUTE_FORCE_MAX_FAILED_ATTEMPTS=5
VITE_AUTH_BRUTE_FORCE_WINDOW_MINUTES=15
VITE_AUTH_ACCOUNT_LOCK_FAILED_ATTEMPTS=5
VITE_AUTH_ACCOUNT_LOCK_DURATION_MINUTES=30
VITE_AUTH_RISK_BLOCK_THRESHOLD=85

# Session inventory and global revoke controls
VITE_ENABLE_SESSION_INVENTORY=true
VITE_ENABLE_SESSION_GLOBAL_REVOKE=true
VITE_AUTH_SESSION_IDLE_UPDATE_SECONDS=60

# Device registry and remote logout controls
VITE_ENABLE_DEVICE_REGISTRY=true
VITE_ENABLE_DEVICE_REMOTE_LOGOUT=true
VITE_AUTH_DEVICE_STALE_DAYS=90

# Notification channels (kept disabled by default)
VITE_ENABLE_EMAIL_NOTIFICATIONS=false
VITE_ENABLE_SMS_NOTIFICATIONS=false
VITE_ENABLE_WHATSAPP_NOTIFICATIONS=false
VITE_ENABLE_INAPP_NOTIFICATIONS=false
