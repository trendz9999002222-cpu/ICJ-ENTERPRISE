# ICJ ENTERPRISE PLATFORM v1.0 STAGING — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.staging and populate staging credentials.

VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_staging_key_here

DATABASE_URL="postgresql://postgres:your_secure_password@staging-host:5432/icj_staging_db"

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_staging_sendgrid_api_key

SMS_PROVIDER=2factor
SMS_API_KEY=your_staging_2factor_api_key_here
FAST2SMS_API_KEY=your_staging_fast2sms_api_key_here

WHATSAPP_PROVIDER=whatsapp
WHATSAPP_API_TOKEN=your_staging_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_staging_whatsapp_phone_number_id_here

VITE_OTP_MODE=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_REQUEST_COOLDOWN_SECONDS=60
